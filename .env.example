# HIPPMEM MCP configuration template
# Copy to .env and fill in real values

# Backend selection: openai-compatible | (empty = deterministic fallback)
HIPPMEM_EMBEDDING_PROVIDER=

# API endpoint (used when provider is set)
HIPPMEM_EMBEDDING_BASE_URL=https://api.openai.com/v1

# Model name (used when provider is set)
HIPPMEM_EMBEDDING_MODEL=text-embedding-3-small

# API key (used when provider is set)
OPENAI_API_KEY=<your-api-key-here>

# PyPI token (for publishing releases)
# https://pypi.org/manage/account/token/
PYPI_TOKEN=pypi-xxxxxxxxxxxx
